# ---- Database ----
# Leave empty to use the local PGlite database in ./data (no install needed).
# Set a Neon Postgres URL when you deploy (same as Rada).
DATABASE_URL=

# ---- Hub login ----
# Protects every hub page. Webhook (/api/whatsapp) stays open for Meta.
HUB_PASSWORD=change-me

# ---- WhatsApp Cloud API (Meta) ----
# Leave empty to run in demo mode: replies are logged, not sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; paste the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=pick-a-random-string
# App secret from Meta (App settings > Basic). Used to verify webhook signatures.
WHATSAPP_APP_SECRET=
